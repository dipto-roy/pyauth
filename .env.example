# Database connection string (REQUIRED)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pyauth

# JWT Configuration (REQUIRED)
# Generate a secure 256-bit key with: openssl rand -hex 32
# NEVER commit real secret keys to version control!
SECRET_KEY=your-256-bit-secret-key-here

# Token expiration in minutes (optional, default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15
